---
import { render } from "astro:content";

import "@/styles/article.css";
import "@/styles/content.css";

import TocPopover from "@/components/article/toc-popover.astro";
import TocRail from "@/components/article/toc-rail.astro";
import TocScript from "@/components/article/toc-script.astro";
import CodeTabs from "@/components/code-tabs.astro";
import Comments from "@/components/comments.astro";
import ContentIslands from "@/components/content-islands.astro";
import ViewCount from "@/components/post/view-count.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getAdjacentPosts, getPosts, getRelatedPosts } from "@/lib/content/posts";
import type { Post } from "@/lib/content/posts";
import { formatDate } from "@/lib/format";
import { proseClasses } from "@/lib/prose";
import { routes } from "@/lib/navigation";
import { siteConfig } from "@/lib/site";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

type Props = { post: Post; posts: Post[] };
const { post, posts } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(post);
const { lastModified, readingTime } = remarkPluginFrontmatter as { lastModified?: string; readingTime: number };

const date = post.data.date.toISOString();
const href = routes.post(post.id);
const url = new URL(href, siteConfig.url).href;
const plainDescription = post.data.descriptionHtml.replace(/<[^>]*>/g, "");
const updated = lastModified && formatDate(lastModified) !== formatDate(date) ? lastModified : undefined;
const related = getRelatedPosts(posts, post, 3);
const { older, newer } = getAdjacentPosts(posts, post);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: plainDescription,
  datePublished: date,
  dateModified: lastModified ?? date,
  url,
  mainEntityOfPage: url,
  keywords: post.data.tags,
  author: { "@type": "Person", name: siteConfig.name, url: siteConfig.url },
};
---

<BaseLayout
  title={post.data.title}
  description={plainDescription}
  canonical={href}
  og={{ type: "article", title: post.data.title, publishedTime: date, modifiedTime: lastModified, tags: post.data.tags }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, "\\u003c")} />
  <TocPopover slot="nav-controls" headings={post.data.headings} />
  <main id="main-content" class="pb-24">
    <div class:list={["article lg:prose-lg", proseClasses]}>
      <header class="article-column not-prose grid gap-4 pt-10 pb-8">
        <h1
          class="text-3xl/tight font-semibold tracking-tight text-balance sm:text-4xl/tight"
          style={{ viewTransitionName: `post-${post.id}` }}
        >
          {post.data.title}
        </h1>
        <div
          class="text-base/7 text-pretty text-muted-foreground sm:text-lg/8 [&_code]:text-[0.875em]"
          set:html={post.data.descriptionHtml}
        />
        <p class="flex flex-wrap gap-x-2 text-sm text-muted-foreground">
          {post.data.draft && <><span class="font-medium text-foreground">Draft</span><span aria-hidden="true">·</span></>}
          <time datetime={date}>{formatDate(date)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
          {
            updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>Updated <time datetime={updated}>{formatDate(updated)}</time></span>
              </>
            )
          }
          <ViewCount slug={post.id} />
        </p>
      </header>
      <div class="relative">
        <TocRail headings={post.data.headings} />
        <article class="article-column article-body">
          <Content />
        </article>
        <ContentIslands names={post.data.components} />
      </div>
      <footer class="article-column not-prose mt-16 grid gap-12 border-t pt-10">
        {
          related.length > 0 && (
            <section aria-labelledby="related-posts">
              <h2 id="related-posts" class="text-sm font-medium text-muted-foreground">
                Related posts
              </h2>
              <ul class="mt-3 grid gap-3">
                {related.map((other) => (
                  <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
                    <a
                      href={routes.post(other.id)}
                      class="font-medium text-pretty underline decoration-current/0 underline-offset-[3px] transition-[text-decoration-color] duration-150 hover:decoration-current/40"
                    >
                      {other.data.title}
                    </a>
                    <time
                      datetime={other.data.date.toISOString()}
                      class="shrink-0 text-sm text-muted-foreground tabular-nums"
                    >
                      {formatDate(other.data.date.toISOString())}
                    </time>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          (older || newer) && (
            <nav aria-label="More posts" class="grid gap-2 sm:grid-cols-2">
              {older && (
                <a
                  href={routes.post(older.id)}
                  class="-mx-3 rounded-md px-3 py-3 transition-colors duration-150 hover:bg-muted"
                >
                  <span class="block text-sm text-muted-foreground">Previous</span>
                  <span class="mt-1 block font-medium text-pretty">{older.data.title}</span>
                </a>
              )}
              {newer && (
                <a
                  href={routes.post(newer.id)}
                  class="-mx-3 rounded-md px-3 py-3 transition-colors duration-150 hover:bg-muted sm:col-start-2 sm:text-right"
                >
                  <span class="block text-sm text-muted-foreground">Next</span>
                  <span class="mt-1 block font-medium text-pretty">{newer.data.title}</span>
                </a>
              )}
            </nav>
          )
        }
        <Comments />
      </footer>
    </div>
  </main>
  <TocScript />
  <CodeTabs />
</BaseLayout>
