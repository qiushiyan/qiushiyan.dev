---
import FeaturedProjects from "@/components/featured-projects.astro";
import PostListItem from "@/components/post/post-list-item.astro";
import BaseLayout from "@/layouts/base-layout.astro";
import { getPosts } from "@/lib/content/posts";
import { routes } from "@/lib/navigation";
import { siteConfig } from "@/lib/site";
import { socialIcons } from "@/lib/social-icons";

const posts = (await getPosts()).slice(0, 5);
const social = [
  { href: siteConfig.links.github, label: "GitHub", path: socialIcons.github },
  { href: siteConfig.links.x, label: "X", path: socialIcons.x },
  { href: siteConfig.links.linkedin, label: "LinkedIn", path: socialIcons.linkedin },
];
---

<BaseLayout>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <main id="main-content" class="mx-auto w-full max-w-2xl py-12 sm:py-16">
      <header>
        <h1 class="text-2xl/8 font-semibold tracking-tight">{siteConfig.name}</h1>
        <p class="mt-3 text-base/7 text-pretty text-muted-foreground">
          I'm a full-stack engineer working on LLM-related products. I write about web development, data tooling and
          programming languages.
        </p>
        {/* -ml-3 keeps the first glyph on the column edge despite the 44px hit area. */}
        <ul aria-label="Elsewhere" class="mt-4 -ml-3 flex">
          {
            social.map(({ href, label, path }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="grid size-11 place-items-center rounded-md text-muted-foreground transition-colors hover:text-foreground"
                >
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="size-5">
                    <path d={path} />
                  </svg>
                  <span class="sr-only">{label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </header>

      <section aria-labelledby="home-posts" class="mt-12">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="home-posts" class="text-sm font-medium text-muted-foreground">Posts</h2>
          <a href={routes.posts} class="text-sm text-muted-foreground transition-colors hover:text-foreground">
            All posts
          </a>
        </div>
        <ol class="mt-4 divide-y divide-border">
          {posts.map((post) => <PostListItem post={post} headingLevel={3} />)}
        </ol>
      </section>

      <section aria-labelledby="home-projects" class="mt-12">
        <h2 id="home-projects" class="text-sm font-medium text-muted-foreground">Projects</h2>
        <FeaturedProjects />
      </section>
    </main>
  </div>
</BaseLayout>
