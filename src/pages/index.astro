---
import BaseLayout from "@/layouts/base-layout.astro";
import { getPosts } from "@/lib/content/posts";
import { formatYear } from "@/lib/format";
import { routes } from "@/lib/navigation";
import { MAIN_CONTENT_ID, siteConfig } from "@/lib/site";
import type { Post } from "@/lib/content/posts";

const posts = (await getPosts()).slice(0, 5);
const postYear = (post: Post) => formatYear(post.data.date.toISOString());
const rows = posts.map((post, index) => ({
  post,
  repeatsYear: index > 0 && postYear(posts[index - 1]!) === postYear(post),
}));

const projects = [
  {
    name: "tidymodels/agua",
    href: "https://tidymodels.github.io/agua",
    description: "Create and evaluate models using tidymodels and h2o",
  },
  {
    name: "js-notebook",
    href: "https://javascript-notebook.netlify.app",
    description: "An interactive notebook for JavaScript and TypeScript",
  },
  {
    name: "linux-command-line-cheatsheet",
    href: "https://github.com/qiushiyan/linux-command-line-cheatsheet",
    description: "A cheatsheet of common Linux commands",
  },
];

const external = { target: "_blank", rel: "noopener noreferrer" };
---

{/*
  One size and two colours: hierarchy comes from colour and position. Every
  control here has its own :active, so the browser's grey tap flash can go.
*/}
<BaseLayout
  canonical={routes.home}
  bodyClass="[-webkit-tap-highlight-color:transparent]"
>
  <main
    id={MAIN_CONTENT_ID}
    class="mx-auto w-full max-w-column px-4 pt-12 pb-16 sm:pt-20"
  >
    <header>
      <h1 class="text-base/6 font-medium">{siteConfig.name}</h1>
      <p class="mt-1 text-base/relaxed text-pretty">
        I’m a full-stack engineer working on <span class="whitespace-nowrap"
          >LLM-related</span
        > products.{" "}
        <span class="text-muted-foreground">
          I write about web development, data tooling and programming languages.
          <span class="block">
            Find me on <a
              class="home-link home-inline"
              href={siteConfig.links.github}
              {...external}>GitHub</a
            >, <a
              class="home-link home-inline home-inline-short"
              href={siteConfig.links.x}
              {...external}>X</a
            > and <a
              class="home-link home-inline"
              href={siteConfig.links.linkedin}
              {...external}>LinkedIn</a
            >.
          </span>
        </span>
      </p>
    </header>

    <section aria-labelledby="home-posts" class="mt-12">
      <div class="flex items-baseline justify-between gap-4">
        <h2 id="home-posts" class="text-base/6 text-muted-foreground">
          Posts
        </h2>
        <a
          href={routes.posts}
          class="home-link relative before:absolute before:-inset-x-2 before:-inset-y-2.5"
        >
          All posts
        </a>
      </div>
      <ol class="index-list mt-2">
        {rows.map(({ post, repeatsYear }) => (
          <li class="index-row relative flex items-baseline justify-between gap-6 py-2.5">
            <h3
              class="min-w-0 text-base/6 break-words"
              style={{ viewTransitionName: `post-${post.id}` }}
            >
              <a href={routes.post(post.id)} class="after:absolute after:inset-0">
                {post.data.title}
              </a>
              {post.data.draft && (
                <span class="text-muted-foreground"> Draft</span>
              )}
            </h3>
            <time
              datetime={post.data.date.toISOString()}
              class:list={[
                "index-secondary shrink-0 text-base/6 tabular-nums",
                repeatsYear && "home-repeat",
              ]}
            >
              {postYear(post)}
            </time>
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="home-projects" class="mt-10">
      <h2 id="home-projects" class="text-base/6 text-muted-foreground">
        Projects
      </h2>
      <ul class="index-list mt-2">
        {projects.map((project) => (
          <li class="index-row relative flex flex-wrap items-baseline justify-between gap-x-6 py-2.5">
            <h3 class="min-w-0 text-base/6 break-words">
              <a
                href={project.href}
                {...external}
                class="after:absolute after:inset-0"
              >
                {project.name}
              </a>
            </h3>
            <p class="index-secondary min-w-0 text-base/6 max-sm:basis-full">
              {project.description}
            </p>
          </li>
        ))}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  /* The year above already covers this row; it returns when the row is in use. */
  .index-list .home-repeat {
    opacity: 0;
    transition:
      opacity 150ms ease-out,
      color 150ms ease-out;
  }

  .index-row:has(a:focus-visible) .home-repeat {
    opacity: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .index-row:hover .home-repeat {
      opacity: 1;
    }
  }

  /* The underline is the only thing marking these inside a muted sentence, so it keeps the text's full contrast. */
  .home-link {
    color: hsl(var(--muted-foreground));
    text-decoration-line: underline;
    text-decoration-thickness: var(--underline-thickness);
    text-underline-offset: var(--underline-offset);
    text-decoration-skip-ink: auto;
    border-radius: calc(var(--radius) - 4px);
    transition: color 150ms ease-out;
  }

  .home-link:active {
    color: hsl(var(--foreground));
  }

  @media (hover: hover) and (pointer: fine) {
    .home-link:hover {
      color: hsl(var(--foreground));
    }
  }

  .home-inline {
    position: relative;
  }

  /* GitHub and X sit 7px apart, so their targets stop short of each other. */
  .home-inline::before {
    content: "";
    position: absolute;
    inset: -0.72rem -3px;
  }

  /* X is one letter; its target grows over the plain " and " beside it. */
  .home-inline-short::before {
    inset-inline-end: -1rem;
  }
</style>
