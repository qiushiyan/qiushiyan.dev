---
import { MAIN_CONTENT_ID } from "@/lib/site";
import BaseLayout from "./base-layout.astro";
import type { ComponentProps } from "astro/types";

/*
  Index and standalone pages (/posts, /notes, /recipes, /about, 404): the
  nav, the site's text column and a header.
*/
type Props = ComponentProps<typeof BaseLayout> & {
  heading: string;
  /** One line under the heading. */
  lead?: string;
  class?: string;
};

const { heading, lead, class: className, ...base } = Astro.props;
---

<BaseLayout {...base}>
  <main
    id={MAIN_CONTENT_ID}
    class:list={[
      "mx-auto w-full max-w-column px-4 pt-12 pb-16 sm:pt-20",
      className,
    ]}
  >
    <header>
      <h1 class="text-2xl/8 font-semibold tracking-tight text-balance">
        {heading}
      </h1>
      {lead && (
        <p class="mt-2 text-base/7 text-pretty text-muted-foreground">{lead}</p>
      )}
    </header>
    <slot />
  </main>
</BaseLayout>
