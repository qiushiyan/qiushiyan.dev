---
import { Font } from "astro:assets";

import "@/styles/globals.css";
import "@/styles/highlight.css";

import Analytics from "@/components/site/analytics.astro";
import SiteNav from "@/components/site/site-nav.astro";
import ThemeScript from "@/components/site/theme-script.astro";
import { routes } from "@/lib/navigation";
import { siteConfig } from "@/lib/site";

/*
  The HTML shell of every page: metadata, fonts, the pre-paint theme script
  and the nav. Slots: `head` for extra tags, `nav-controls` for icon buttons
  before search (e.g. the table of contents).
*/
type Props = {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Canonical path, e.g. "/posts/foo". */
  canonical?: string;
  /** The page's Open Graph card, as a path under /og/ (see src/pages/og/[...card].png.ts). */
  ogCard?: string;
  /** Article metadata. Posts keep `og:title` the bare title: Giscus maps discussions by it. */
  article?: { publishedTime: string; modifiedTime?: string; tags?: string[] };
  /** Extra classes on <body>, e.g. `h-dvh` for the full-height recipe page. */
  bodyClass?: string;
};

const {
  title,
  description = siteConfig.description,
  canonical,
  ogCard = "site",
  article,
  bodyClass,
} = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const ogImage = new URL(routes.og(ogCard), siteConfig.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && (
      <link rel="canonical" href={new URL(canonical, siteConfig.url)} />
    )}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={routes.feed}
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title ?? siteConfig.name} />
    <meta property="og:description" content={description} />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, siteConfig.url)}
    />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {article && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {article?.tags?.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <ThemeScript />
    <slot name="head" />
  </head>
  <body
    class:list={[
      "flex min-h-dvh flex-col bg-background font-sans text-foreground antialiased",
      bodyClass,
    ]}
  >
    <SiteNav>
      <slot name="nav-controls" slot="controls" />
    </SiteNav>
    <slot />
    <Analytics />
  </body>
</html>
