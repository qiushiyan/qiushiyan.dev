---
import { Font } from "astro:assets";

import "@/styles/globals.css";
import "@/styles/highlight.css";

import SiteNav from "@/components/site-nav.astro";
import ThemeScript from "@/components/theme-script.astro";
import { siteConfig } from "@/lib/site";

type Props = {
  title?: string;
  description?: string;
  /** Open Graph fields; posts pass type "article" and their bare title (Giscus maps threads by og:title). */
  og?: { type: "website" | "article"; title?: string; publishedTime?: string; modifiedTime?: string; tags?: string[] };
  canonical?: string;
};

const { title, description = siteConfig.description, og = { type: "website" }, canonical } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
---

<!doctype html>
<html lang="en" data-scroll-behavior="smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={new URL(canonical, Astro.site)} />}
    <link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/feed.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content={og.type} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={og.title ?? title ?? siteConfig.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    {og.publishedTime && <meta property="article:published_time" content={og.publishedTime} />}
    {og.modifiedTime && <meta property="article:modified_time" content={og.modifiedTime} />}
    {og.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <ThemeScript />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col bg-background font-sans text-foreground antialiased">
    <SiteNav>
      <slot name="nav-controls" slot="controls" />
    </SiteNav>
    <slot />
  </body>
</html>
