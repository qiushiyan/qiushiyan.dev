---
import { DoCounterExample } from "./post-example/do-counter";

/*
  Interactive components a post's Markdown names with a custom element, e.g.
  `<do-counter-example />`. A `.md` body can't render components, so each
  island renders here, hidden, and the script moves it into its element's
  place. The post's frontmatter `components` list says which to render, so
  only those pages ship the island's JavaScript.
*/
type Props = { names: string[] };
const { names } = Astro.props;
---

<div hidden data-content-islands>
  {
    names.includes("do-counter-example") && (
      <div data-island-for="do-counter-example">
        <DoCounterExample client:visible />
      </div>
    )
  }
</div>

<script>
  for (const island of document.querySelectorAll<HTMLElement>("[data-island-for]")) {
    const target = document.querySelector(island.dataset.islandFor!);
    if (target) target.replaceWith(...island.childNodes);
  }
</script>
