---
import Comments from "@/components/article/comments.astro";
import { formatDate } from "@/lib/format";
import { routes } from "@/lib/navigation";
import type { Post } from "@/lib/content/posts";

/* Below a post: up to three related posts, the older/newer pager and comments. */
type Props = { related: Post[]; older?: Post; newer?: Post };
const { related, older, newer } = Astro.props;
---

<footer class="article-column not-prose mt-16 grid gap-12 border-t pt-10">
  {related.length > 0 && (
    <section aria-labelledby="related-posts">
      <h2 id="related-posts" class="text-sm font-medium text-muted-foreground">
        Related posts
      </h2>
      <ul class="mt-3 grid gap-3">
        {related.map((post) => (
          <li class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <a
              href={routes.post(post.id)}
              class="font-medium text-pretty underline decoration-current/0 underline-offset-[3px] transition-[text-decoration-color] duration-150 hover:decoration-current/40"
            >
              {post.data.title}
            </a>
            <time
              datetime={post.data.date.toISOString()}
              class="shrink-0 text-sm text-muted-foreground tabular-nums"
            >
              {formatDate(post.data.date.toISOString())}
            </time>
          </li>
        ))}
      </ul>
    </section>
  )}
  {(older || newer) && (
    <nav aria-label="More posts" class="grid gap-2 sm:grid-cols-2">
      {older && (
        <a
          href={routes.post(older.id)}
          class="-mx-3 rounded-md px-3 py-3 transition-colors duration-150 hover:bg-muted"
        >
          <span class="block text-sm text-muted-foreground">Previous</span>
          <span class="mt-1 block font-medium text-pretty">
            {older.data.title}
          </span>
        </a>
      )}
      {newer && (
        <a
          href={routes.post(newer.id)}
          class="-mx-3 rounded-md px-3 py-3 transition-colors duration-150 hover:bg-muted sm:col-start-2 sm:text-right"
        >
          <span class="block text-sm text-muted-foreground">Next</span>
          <span class="mt-1 block font-medium text-pretty">
            {newer.data.title}
          </span>
        </a>
      )}
    </nav>
  )}
  <Comments />
</footer>
