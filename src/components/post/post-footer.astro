---
import Comments from "@/components/article/comments.astro";
import { formatYear } from "@/lib/format";
import { routes } from "@/lib/navigation";
import type { Post } from "@/lib/content/posts";

/* Below a post: the home page's rows for the older and newer post and up to three related ones, then comments. */
type Props = { related: Post[]; older?: Post; newer?: Post };
const { related, older, newer } = Astro.props;
const rows = [
  ...(older ? [{ kind: "Previous", post: older }] : []),
  ...(newer ? [{ kind: "Next", post: newer }] : []),
  ...related.map((post) => ({ kind: "Related", post })),
];
---

<footer class="article-column not-prose mt-16 grid gap-12 border-t pt-10">
  {rows.length > 0 && (
    <nav aria-label="More posts">
      <ul class="index-list text-base/6">
        {rows.map(({ kind, post }) => (
          <li class="index-row relative grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-6 py-2.5 sm:grid-cols-[5rem_minmax(0,1fr)_auto] sm:gap-x-2">
            <span class="index-secondary max-sm:col-span-full">{kind}</span>
            <a
              href={routes.post(post.id)}
              aria-label={`${kind}: ${post.data.title}`}
              class="min-w-0 text-pretty break-words after:absolute after:inset-0"
            >
              {post.data.title}
            </a>
            <time
              datetime={post.data.date.toISOString()}
              class="index-secondary tabular-nums"
            >
              {formatYear(post.data.date.toISOString())}
            </time>
          </li>
        ))}
      </ul>
    </nav>
  )}
  <Comments />
</footer>
