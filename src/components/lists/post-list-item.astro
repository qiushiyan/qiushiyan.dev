---
import { tagSlug } from "@/lib/content/posts";
import { formatDate } from "@/lib/format";
import { routes } from "@/lib/navigation";
import type { Post } from "@/lib/content/posts";

type Props = { post: Post };
const { post } = Astro.props;
---

{/* One post row: only the title is a link, stretched over the whole row. */}
<li
  class="post-row group relative"
  data-tags={post.data.tags.map(tagSlug).join(" ")}
>
  <h2
    class="text-base/6 font-medium"
    style={{ viewTransitionName: `post-${post.id}` }}
  >
    <a
      href={routes.post(post.id)}
      class="transition-colors group-hover:text-primary after:absolute after:inset-0"
    >
      {post.data.title}
    </a>
  </h2>
  <div
    class="mt-1 line-clamp-2 text-sm/6 text-muted-foreground [&_code]:text-[0.875em]"
    set:html={post.data.descriptionHtml}
  />
  <p class="mt-2 text-sm text-muted-foreground">
    <time datetime={post.data.date.toISOString()} class="tabular-nums">
      {formatDate(post.data.date.toISOString())}
    </time>
    {post.data.tags.length > 0 && (
      <>
        <span aria-hidden="true"> · </span>
        {post.data.tags.join(", ")}
      </>
    )}
    {post.data.draft && (
      <span class="ml-2 font-medium text-foreground">Draft</span>
    )}
  </p>
</li>

<style>
  /* Written against visible rows: the tag filter hides rows in place. */
  .post-row {
    border-block-start: 1px solid var(--color-border);
    padding-block: 1.25rem;
  }

  .post-row:nth-child(1 of :not([hidden])) {
    border-block-start: 0;
    padding-block-start: 0;
  }
</style>
