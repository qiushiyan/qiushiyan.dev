---
import { tagSlug } from "@/lib/content/posts";
import { formatDate } from "@/lib/format";
import { routes } from "@/lib/navigation";
import type { Post } from "@/lib/content/posts";

type Props = { post: Post; headingLevel?: 2 | 3 };
const { post, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
---

{/* One post row: only the title is a link, stretched over the whole row. */}
<li
  class="group relative py-5 first:pt-0"
  data-tags={post.data.tags.map(tagSlug).join(" ")}
>
  <Heading
    class="text-base/6 font-medium text-balance"
    style={{ viewTransitionName: `post-${post.id}` }}
  >
    <a
      href={routes.post(post.id)}
      class="transition-colors group-hover:text-primary after:absolute after:inset-0"
    >
      {post.data.title}
    </a>
  </Heading>
  <div
    class="mt-1 line-clamp-2 text-sm/6 text-pretty text-muted-foreground [&_code]:text-[0.875em]"
    set:html={post.data.descriptionHtml}
  />
  <p class="mt-2 text-sm text-muted-foreground">
    <time datetime={post.data.date.toISOString()} class="tabular-nums">
      {formatDate(post.data.date.toISOString())}
    </time>
    {post.data.tags.length > 0 && (
      <>
        <span aria-hidden="true"> · </span>
        {post.data.tags.join(", ")}
      </>
    )}
    {post.data.draft && (
      <span class="ml-2 font-medium text-foreground">Draft</span>
    )}
  </p>
</li>
