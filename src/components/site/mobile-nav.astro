---
import { isActivePath, navLinks, publicPath, routes } from "@/lib/navigation";
import NavIconButton from "./nav-icon-button.astro";

const pathname = publicPath(Astro.url.pathname);
---

{/* A native popover: light dismiss, Escape and focus return come from the browser. */}
<NavIconButton
  aria-label="Menu"
  popovertarget="mobile-menu"
  class:list={[
    "md:hidden",
    // The home page keeps its links on phones, so there the menu is only for the narrowest.
    pathname === routes.home && "min-[22.5rem]:hidden",
  ]}
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-5"
  >
    <path d="M3 5H11"></path>
    <path d="M3 12H16"></path>
    <path d="M3 19H21"></path>
  </svg>
</NavIconButton>
<div id="mobile-menu" popover class="nav-popover w-56 p-1">
  <nav aria-label="Main">
    <ul>
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            aria-current={
              isActivePath(pathname, link.href) ? "page" : undefined
            }
            class="flex h-11 items-center rounded-sm px-3 text-base text-muted-foreground -outline-offset-2 transition-colors hover:bg-muted hover:text-foreground active:bg-muted active:text-foreground aria-[current=page]:bg-muted aria-[current=page]:text-foreground"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>
