---
import { isActivePath, navLinks, publicPath, routes } from "@/lib/navigation";
import { MAIN_CONTENT_ID, siteConfig } from "@/lib/site";
import MobileNav from "./mobile-nav.astro";
import SiteSearch from "./site-search.astro";
import ThemeToggle from "./theme-toggle.astro";

type Props = {
  /** A full-width tool page: the nav spans it, and keeps its hairline because nothing scrolls under it. */
  wide?: boolean;
};

const { wide = false } = Astro.props;
const pathname = publicPath(Astro.url.pathname);
const isHome = pathname === routes.home;
const links = [{ href: routes.home, label: "Home" }, ...navLinks];
---

{/*
  One nav on every page, lined up with the text column. Phones have no room
  for the links beside the icons, so they show the name and a menu. Only the
  home page keeps its links there: four words and two icons fit from 360px.
*/}
<header
  data-site-nav
  class:list={[
    "sticky top-0 z-40 h-(--nav-height) shrink-0 border-b bg-background",
    wide
      ? "border-border"
      : "border-transparent transition-[border-color] duration-150 ease-out data-scrolled:border-border",
  ]}
>
  <a
    href={`#${MAIN_CONTENT_ID}`}
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-4 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:shadow-md"
  >
    Skip to content
  </a>
  <div
    class:list={[
      "mx-auto flex h-full w-full items-center gap-6 px-4",
      !wide && "max-w-column",
    ]}
  >
    {!isHome && (
      <a
        href={routes.home}
        class="rounded-md py-2.5 font-medium transition-colors active:text-muted-foreground md:hidden"
      >
        {siteConfig.name}
      </a>
    )}
    <nav
      aria-label="Main"
      class:list={[
        "mr-auto -ml-1.5 hidden items-center md:flex md:-ml-3",
        isHome && "min-[22.5rem]:flex",
      ]}
    >
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={isActivePath(pathname, link.href) ? "page" : undefined}
          class:list={[
            "inline-flex h-11 items-center rounded-md px-1.5 text-base text-muted-foreground transition-colors hover:text-foreground active:text-foreground aria-[current=page]:text-foreground md:h-10 md:px-3",
            link.href === routes.home && "max-md:hidden",
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
    {/* The negative margin lines the sun's rays up with the container edge. */}
    <div class="-mr-3 flex items-center max-md:ml-auto">
      <slot name="controls" />
      <SiteSearch />
      <ThemeToggle />
      <MobileNav />
    </div>
  </div>
</header>

<script>
  // The hairline appears once the page has moved under the nav.
  const nav = document.querySelector("[data-site-nav]");
  const update = () => nav?.toggleAttribute("data-scrolled", scrollY > 8);
  addEventListener("scroll", update, { passive: true });
  update();
</script>
