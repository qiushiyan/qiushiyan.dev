---
import ArticleToc from "./article-toc.astro";

type Props = { headings: { slug: string; depth: number; html: string }[] };
const { headings } = Astro.props;
---

{/* The table of contents at 80rem and up, sticky in the rail left of the text column. */}
{headings.length > 0 && (
  <nav
    aria-labelledby="toc-rail-label"
    class="sticky top-[calc(var(--nav-height)+2rem)] ml-auto hidden max-h-[calc(100dvh-var(--nav-height)-4rem)] w-full max-w-56 overflow-y-auto text-sm/6 xl:block"
  >
    <p id="toc-rail-label" class="mb-3 font-medium text-foreground">
      On this page
    </p>
    <ArticleToc headings={headings} itemClass="py-1" />
  </nav>
)}
