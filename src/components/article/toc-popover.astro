---
import TableOfContents from "@lucide/astro/icons/table-of-contents";

import NavIconButton from "@/components/site/nav-icon-button.astro";
import ArticleToc from "./article-toc.astro";

type Props = { headings: { slug: string; depth: number; html: string }[] };
const { headings } = Astro.props;
---

{/* The table of contents below 80rem, where there is no room for the rail: a native popover from the nav. */}
{headings.length > 0 && (
  <>
    <NavIconButton
      aria-label="On this page"
      popovertarget="toc-popover"
      class="xl:hidden"
    >
      <TableOfContents aria-hidden="true" stroke-width={1.5} class="size-5" />
    </NavIconButton>
    <div
      id="toc-popover"
      popover
      class="nav-popover w-80 overflow-clip text-sm/6"
    >
      <nav
        aria-label="On this page"
        class="max-h-[calc(100dvh-var(--nav-height)-1.25rem)] overflow-y-auto overscroll-contain p-3"
      >
        <ArticleToc headings={headings} itemClass="py-2.5" />
      </nav>
    </div>
  </>
)}

<script>
  // Jumping to a section closes the popover and leaves focus at the section.
  document.getElementById("toc-popover")?.addEventListener("click", (event) => {
    if ((event.target as Element).closest("a")) {
      (event.currentTarget as HTMLElement).hidePopover();
    }
  });
</script>
