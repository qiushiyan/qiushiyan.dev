---
/*
  Behaviour for <code-tabs>, the markup src/lib/content/markdown.ts makes
  from a <code-switcher>: the WAI-ARIA tabs pattern, with arrow keys moving
  between tabs. Without JavaScript the first tab shows.
*/
---

<script>
  class CodeTabs extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (index: number) => {
        tabs.forEach((tab, i) => {
          const selected = i === index;
          tab.setAttribute("aria-selected", String(selected));
          tab.tabIndex = selected ? 0 : -1;
          document.getElementById(tab.getAttribute("aria-controls")!)!.hidden = !selected;
        });
      };
      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => select(index));
        tab.addEventListener("keydown", (event) => {
          const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
          if (!step) return;
          const next = (index + step + tabs.length) % tabs.length;
          select(next);
          tabs[next].focus();
        });
      });
    }
  }
  customElements.define("code-tabs", CodeTabs);
</script>
