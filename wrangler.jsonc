{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qiushiyan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // `astro build` writes every page to dist/; only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "personal-website",
      "database_id": "327bba3d-2bc5-434a-86a7-67c78582f0fa",
    },
  ],
  // Limits view-count increments to one per visitor IP and post per minute
  // (worker/index.ts). `period` must be 10 or 60.
  "ratelimits": [
    {
      "name": "VIEWS_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 1, "period": 60 },
    },
  ],
}
